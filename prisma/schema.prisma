// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRADOR
  DIRECTOR
  GERENTE
  COLABORADOR
}

enum DocumentType {
  PRESUPUESTO
  PROYECTO
  REPORTE
  CONTRATO
  OTRO
}

enum SubmissionStatus {
  ENVIADO
  EN_REVISION_DIRECCION
  OBJETADO
  APROBADO
  RECHAZADO
}

enum HistoryAction {
  ENVIADO
  REENVIADO
  APROBADO_GERENTE
  OBJETADO
  APROBADO
  RECHAZADO
  COMENTARIO
}

enum SupplierType {
  FABRICANTE
  DISTRIBUIDOR
  MAYORISTA
  MINORISTA
  SERVICIOS
  IMPORTADOR
  OTRO
}

enum SupplierStatus {
  POTENCIAL
  EN_EVALUACION
  APROBADO
  ACTIVO
  RECHAZADO
  INACTIVO
}

model Company {
  id        String   @id @default(cuid())
  name      String
  logoPath  String?
  createdAt DateTime @default(now())

  users       User[]
  submissions Submission[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(COLABORADOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  submissions     Submission[]      @relation("AuthorSubmissions")
  documentVersions DocumentVersion[]
  historyEvents   HistoryEvent[]
  suppliers       Supplier[]
}

model Submission {
  id             String            @id @default(cuid())
  title          String
  description    String?
  type           DocumentType      @default(OTRO)
  status         SubmissionStatus  @default(ENVIADO)
  currentVersion Int               @default(1)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  authorId String
  author   User   @relation("AuthorSubmissions", fields: [authorId], references: [id])

  versions DocumentVersion[]
  history  HistoryEvent[]
}

model DocumentVersion {
  id              String   @id @default(cuid())
  versionNumber   Int
  originalName    String
  storedName      String
  mimeType        String
  fileSize        Int
  note            String?
  createdAt       DateTime @default(now())

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  historyEvents HistoryEvent[]

  @@unique([submissionId, versionNumber])
}

model HistoryEvent {
  id        String        @id @default(cuid())
  action    HistoryAction
  comment   String?
  createdAt DateTime      @default(now())

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  versionId String?
  version   DocumentVersion? @relation(fields: [versionId], references: [id])

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])
}

model Supplier {
  id String @id @default(cuid())

  // Identificación
  legalName String // Razón social
  tradeName String? // Nombre comercial / marca
  taxId     String? // RIF / NIT / cédula fiscal

  // Ubicación (para planificar y agrupar visitas por ciudad)
  city    String
  state   String?
  country String  @default("Venezuela")
  address String?

  // Contacto
  contactName String?
  contactRole String?
  phone       String?
  whatsapp    String?
  email       String?
  website     String?

  // Clasificación
  type     SupplierType @default(OTRO)
  category String? // rubro / línea principal (ej. materia prima, empaque, servicios)
  products String? // productos o servicios que ofrece

  // Calificación y condiciones comerciales
  status         SupplierStatus @default(POTENCIAL)
  qualityRating  Int? // 1-5
  priceRating    Int? // 1-5
  deliveryRating Int? // 1-5
  serviceRating  Int? // 1-5
  paymentTerms   String? // condiciones de pago ofrecidas
  minOrder       String? // pedido / monto mínimo
  hasInvoice     Boolean @default(false) // factura fiscal / formalidad
  certifications String?

  notes     String? // observaciones libres de la visita
  visitDate DateTime? // fecha en que se levantó la información

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registeredById String
  registeredBy   User   @relation(fields: [registeredById], references: [id])

  @@index([city])
  @@index([status])
}
