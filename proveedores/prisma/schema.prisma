// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SupplierType {
  FABRICANTE
  DISTRIBUIDOR
  MAYORISTA
  MINORISTA
  SERVICIOS
  IMPORTADOR
  OTRO
}

enum SupplierStatus {
  POTENCIAL
  EN_EVALUACION
  APROBADO
  ACTIVO
  RECHAZADO
  INACTIVO
}

enum PhotoCategory {
  LOCAL
  PRODUCTO
  TARJETA
  DOCUMENTO
  OTRO
}

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  passwordHash      String
  isAdmin            Boolean  @default(false)
  canEditSuppliers   Boolean  @default(false) // puede editar fichas de proveedores ya registradas (otorgado por un administrador)
  canDeleteSuppliers Boolean  @default(false) // puede eliminar proveedores (otorgado por un administrador)
  active             Boolean  @default(true)
  createdAt         DateTime @default(now())

  suppliers        Supplier[] @relation("SupplierRegisteredBy")
  updatedSuppliers Supplier[] @relation("SupplierUpdatedBy")
  photos           Photo[]
}

model Supplier {
  id String @id @default(cuid())

  // Identificación
  legalName String // Razón social
  tradeName String? // Nombre comercial / marca
  taxId     String? // RIF / NIT / cédula fiscal

  // Ubicación (para planificar y agrupar visitas por ciudad)
  city    String
  state   String?
  country String  @default("Venezuela")
  address String?

  // Contacto
  contactName      String?
  contactRole      String?
  phone            String?
  phoneExt         String? // extensión telefónica
  whatsapp         String?
  email            String?
  website          String?
  additionalContacts Json? // contactos adicionales opcionales: [{ name, role, phone }]

  // Clasificación
  type                 SupplierType @default(OTRO)
  category             String? // rubro / línea principal (ej. materia prima, empaque, servicios)
  products             String? // productos o servicios que ofrece
  isBrandRepresentative Boolean @default(false) // es distribuidor/representante exclusivo de una marca
  representedBrand     String? // cuál marca representa

  // Calificación y condiciones comerciales
  status             SupplierStatus @default(POTENCIAL)
  qualityRating      Int? // 1-5
  priceRating        Int? // 1-5
  deliveryRating     Int? // 1-5
  serviceRating      Int? // 1-5 (otros)
  currencies         String[] @default([]) // monedas de cobro que acepta: USD, EUR, BS, COP, USDT, EFECTIVO, OTRO
  currencyOther       String? // detalle cuando currencies incluye OTRO
  paymentMethods     String[] @default([]) // TRANSFERENCIA, ZELLE, BINANCE, PAGO_MOVIL, EFECTIVO, ZINLI, TARJETA, BANESCO_PANAMA, OTRO
  paymentMethodOther String? // detalle cuando paymentMethods incluye OTRO
  paymentTerms       String? // condiciones de pago ofrecidas
  minOrder           String? // pedido / monto mínimo
  hasInvoice         Boolean @default(false) // factura fiscal / formalidad
  certifications     String?

  notes     String? // observaciones libres de la visita
  visitDate DateTime? // fecha en que se levantó la información

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registeredById String
  registeredBy   User   @relation("SupplierRegisteredBy", fields: [registeredById], references: [id])

  updatedById String?
  updatedBy   User?   @relation("SupplierUpdatedBy", fields: [updatedById], references: [id])

  photos Photo[]

  @@index([city])
  @@index([status])
}

model Photo {
  id           String        @id @default(cuid())
  data         Bytes // contenido de la imagen, guardado directamente en la base de datos
  originalName String
  mimeType     String
  fileSize     Int
  category     PhotoCategory @default(OTRO)
  caption      String?
  createdAt    DateTime      @default(now())

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
}
